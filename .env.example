# Copy to .env. Replace placeholders with freshly generated secrets.
# DO NOT COMMIT .env TO GIT.
DB_NAME=tododb
DB_USER=planify
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD

# At least 32 random characters. Changing this invalidates current JWT sessions.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_SECRET

# Match your local model gateway's newly rotated API token.
OPENAI_API_KEY=CHANGE_ME_TO_YOUR_MODEL_GATEWAY_TOKEN
OPENAI_API_URL=http://host.docker.internal:8000/v1/chat/completions
OPENAI_MODEL=qwen3-1.7b

# Allowed cross-origin clients. Nginx same-origin traffic requires no CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173
