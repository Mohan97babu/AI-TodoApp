# Copy to .env or use start-docker.ps1 / start-docker.sh to generate safe secrets.
# Never commit .env. Docker runs Qwen3 in an Ollama container automatically.

DB_NAME=tododb
DB_USER=planify
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_SECRET

# Docker model selection: cached in the ollama_data volume after first startup.
# qwen3:1.7b is a ~1.4GB Q4_K_M image, NOT your E:\model Q6_K GGUF.
OLLAMA_MODEL=qwen3:1.7b

# These variables are used by the standalone Windows (non-Docker) launcher.
# Docker Compose automatically connects to http://ollama:11434 inside its network.
OPENAI_API_KEY=CHANGE_ME_TO_YOUR_STANDALONE_GATEWAY_TOKEN
OPENAI_API_URL=http://localhost:8000/v1/chat/completions
OPENAI_MODEL=qwen3-1.7b

CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173
